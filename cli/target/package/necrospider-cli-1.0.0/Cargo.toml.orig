[package]
name = "necrospider-cli"
version = "1.0.0"
edition = "2021"
description = "An advanced OSINT automation tool launcher with a stunning interactive TUI."
license = "MIT"
repository = "https://github.com/ch0udharyji/NecroSpider"
readme = "README.md"
keywords = ["osint", "security", "tui", "automation", "cybersecurity"]
categories = ["command-line-utilities"]
exclude = [
    "target/*",
    "Cargo.lock"
]

[dependencies]
inquire = "0.6"
crossterm = "0.27"
indicatif = "0.17"
